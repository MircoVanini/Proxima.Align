<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate.Resources>

        <ControlTemplate x:Key="CheckBoxTemplate" TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">

                <Border x:Name="Box"
                        Width="13" Height="13"
                        BorderThickness="1"
                        BorderBrush="{Binding ColorBoxBorder}"
                        Background="{Binding ColorBoxBg}"
                        VerticalAlignment="Center" Margin="0,0,5,0">

                    <Path x:Name="Checkmark"
                          Data="M 1,5 L 4.5,8.5 L 10,2"
                          Stroke="{Binding ColorBoxCheck}"
                          StrokeThickness="1.5"
                          Visibility="Collapsed"
                          SnapsToDevicePixels="True"/>
                </Border>

                <ContentPresenter VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
            </StackPanel>

            <ControlTemplate.Triggers>
                <!-- Checked -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <!-- IsChecked=null (indeterminate) -->
                <Trigger Property="IsChecked" Value="{x:Null}">
                    <Setter TargetName="Box" Property="Background" Value="#80808080"/>
                </Trigger>
                <!-- Mouse over -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF007ACC"/>
                </Trigger>
                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ── Style CheckBox ── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"       Value="{Binding ColorForeground}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"         Value="{StaticResource CheckBoxTemplate}"/>
        </Style>

        <!-- ── Style GroupBox ── -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"       Value="{Binding ColorForeground}"/>
            <Setter Property="Background"       Value="{Binding ColorGroupBg}"/>
            <Setter Property="BorderBrush"      Value="{Binding ColorGroupBorder}"/>
            <Setter Property="BorderThickness"  Value="1"/>
        </Style>

        <!-- ── Style Button ── -->
        <Style TargetType="Button">
            <Setter Property="Foreground"     Value="{Binding ColorForeground}"/>
            <Setter Property="Background"     Value="{Binding ColorBtnBg}"/>
            <Setter Property="BorderBrush"    Value="{Binding ColorBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="10,4"/>
            <Setter Property="Cursor"         Value="Hand"/>
        </Style>

        <!-- ── Style TextBlock ── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding ColorForeground}"/>
        </Style>

    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12"
                  Background="{Binding ColorBackground}">
        <StackPanel>

            <TextBlock FontSize="14" FontWeight="Bold" Margin="0,0,0,12"
                       Text="Proxima Align – Settings"/>

            <GroupBox Header="Operators to align" Margin="0,0,0,12" Padding="8">
                <WrapPanel>
                    <CheckBox Content="="          IsChecked="{Binding OpAssign}"  Margin="4"/>
                    <CheckBox Content="+="         IsChecked="{Binding OpPlusEq}"  Margin="4"/>
                    <CheckBox Content="-="         IsChecked="{Binding OpMinusEq}" Margin="4"/>
                    <CheckBox Content="*="         IsChecked="{Binding OpMulEq}"   Margin="4"/>
                    <CheckBox Content="/="         IsChecked="{Binding OpDivEq}"   Margin="4"/>
                    <CheckBox Content="%="         IsChecked="{Binding OpModEq}"   Margin="4"/>
                    <CheckBox Content="&amp;="     IsChecked="{Binding OpAndEq}"   Margin="4"/>
                    <CheckBox Content="|="         IsChecked="{Binding OpOrEq}"    Margin="4"/>
                    <CheckBox Content="^="         IsChecked="{Binding OpXorEq}"   Margin="4"/>
                    <CheckBox Content="&lt;&lt;="  IsChecked="{Binding OpShlEq}"   Margin="4"/>
                    <CheckBox Content=">>="        IsChecked="{Binding OpShrEq}"   Margin="4"/>
                    <CheckBox Content="=>"         IsChecked="{Binding OpArrow}"   Margin="4"/>
                </WrapPanel>
            </GroupBox>
            
            <GroupBox Header="Spacing around operator" Margin="0,0,0,12" Padding="8">
                <StackPanel>
                    <CheckBox Content="Space before operator"
                              IsChecked="{Binding SpaceBefore}" Margin="0,4"/>
                    <CheckBox Content="Space after operator"
                              IsChecked="{Binding SpaceAfter}"  Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Logging" Margin="0,0,0,12" Padding="8">
                <WrapPanel>
                    <CheckBox Content="Enable logging to (%appdata%\Proxima.Align)" IsChecked="{Binding EnableLog}"   Margin="4"/>
                </WrapPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Restore defaults"
                        Command="{Binding RestoreCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</DataTemplate>