<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:styles="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <DataTemplate.Resources>
        <Style TargetType="CheckBox"
               BasedOn="{StaticResource {x:Static styles:VsResourceKeys.CheckBoxStyleKey}}"/>
        <Style TargetType="Button"
               BasedOn="{StaticResource {x:Static styles:VsResourceKeys.ButtonStyleKey}}"/>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"/>
            <Setter Property="Background"
                    Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBorderKey}}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static styles:VsBrushes.ToolWindowTextKey}}"/>
        </Style>
    </DataTemplate.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Padding="12"
                  Background="{DynamicResource {x:Static styles:VsBrushes.ToolWindowBackgroundKey}}">
        <StackPanel>
            <TextBlock FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,12"
                       Text="Proxima Align - Settings"/>

            <GroupBox Header="Operators to align" Margin="0,0,0,12" Padding="8">
                <WrapPanel>
                    <CheckBox Content="="         IsChecked="{Binding OpAssign}"  Margin="4"/>
                    <CheckBox Content="+="        IsChecked="{Binding OpPlusEq}"  Margin="4"/>
                    <CheckBox Content="-="        IsChecked="{Binding OpMinusEq}" Margin="4"/>
                    <CheckBox Content="*="        IsChecked="{Binding OpMulEq}"   Margin="4"/>
                    <CheckBox Content="/="        IsChecked="{Binding OpDivEq}"   Margin="4"/>
                    <CheckBox Content="%="        IsChecked="{Binding OpModEq}"   Margin="4"/>
                    <CheckBox Content="&amp;="    IsChecked="{Binding OpAndEq}"   Margin="4"/>
                    <CheckBox Content="|="        IsChecked="{Binding OpOrEq}"    Margin="4"/>
                    <CheckBox Content="^="        IsChecked="{Binding OpXorEq}"   Margin="4"/>
                    <CheckBox Content="&lt;&lt;=" IsChecked="{Binding OpShlEq}"   Margin="4"/>
                    <CheckBox Content=">>="       IsChecked="{Binding OpShrEq}"   Margin="4"/>
                    <CheckBox Content="=>"        IsChecked="{Binding OpArrow}"   Margin="4"/>
                </WrapPanel>
            </GroupBox>

            <GroupBox Header="Spacing around operator" Margin="0,0,0,12" Padding="8">
                <StackPanel>
                    <CheckBox Content="Space before operator"
                              IsChecked="{Binding SpaceBefore}"
                              Margin="0,4"/>
                    <CheckBox Content="Space after operator"
                              IsChecked="{Binding SpaceAfter}"
                              Margin="0,4"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Logging" Margin="0,0,0,12" Padding="8">
                <WrapPanel>
                    <CheckBox Content="Enable logging to (%appdata%\Proxima.Align)" IsChecked="{Binding EnableLog}"   Margin="4"/>
                </WrapPanel>
            </GroupBox>

            <TextBlock Text="{Binding SaveStatusMessage}" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Foreground"
                                Value="{DynamicResource {x:Static styles:VsBrushes.InfoTextKey}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSaveStatus}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="Restore defaults"
                        Command="{Binding RestoreCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</DataTemplate>
